setCommandLineOptions("--newBackend");
r := simulate(D9, stopTime=0.1, fileNamePrefix="D9N"); print(r.messages); print(getErrorString());
r := simulate(D11, stopTime=0.1, fileNamePrefix="D11N"); print(r.messages); print(getErrorString());
