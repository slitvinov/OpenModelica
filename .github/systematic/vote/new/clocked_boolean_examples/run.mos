loadModel(Modelica, {"4.1.0"}); getErrorString();
r := simulate(Modelica.Clocked.Examples.Elementary.BooleanSignals.BackSample, stopTime=0.09, numberOfIntervals=90, fileNamePrefix="O");
setCommandLineOptions("--newBackend");
r := simulate(Modelica.Clocked.Examples.Elementary.BooleanSignals.BackSample, stopTime=0.09, numberOfIntervals=90, fileNamePrefix="N"); print(getErrorString());
