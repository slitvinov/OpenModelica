loadFile("M2063.mo"); getErrorString();
r := simulate(M2063, stopTime=2, numberOfIntervals=20, tolerance=1e-8, fileNamePrefix="O"); print("old: " + r.messages + "\n");
setCommandLineOptions("--newBackend");
r := simulate(M2063, stopTime=2, numberOfIntervals=20, tolerance=1e-8, fileNamePrefix="N"); print("new: " + r.messages + "\n");
for t in {1.3, 1.5, 2.0} loop print("t=" + String(t) + " old x2=" + String(val(x2, t, "O_res.mat")) + " new x2=" + String(val(x2, t, "N_res.mat")) + "\n"); end for;
