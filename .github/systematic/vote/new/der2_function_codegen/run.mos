loadFile("D5.mo"); loadFile("D6.mo"); getErrorString();
r := simulate(D5, stopTime=1, fileNamePrefix="D5O"); print("old D5: " + r.messages + "\n");
setCommandLineOptions("--newBackend");
r := simulate(D5, stopTime=1, fileNamePrefix="D5N"); print("new D5: " + r.messages + "\n"); print(getErrorString());
r := simulate(D6, stopTime=1, fileNamePrefix="D6N"); print("new D6: " + r.messages + "\n"); print(getErrorString());
print("old a(1)=" + String(val(a, 1, "D5O_res.mat")) + " exact 4*exp(-2)=" + String(4*exp(-2)) + "\n");
