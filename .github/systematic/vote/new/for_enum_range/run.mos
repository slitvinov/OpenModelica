loadFile("EN.mo"); loadFile("EN2.mo"); getErrorString();
r := simulate(EN, stopTime=1, fileNamePrefix="ENO"); print("old EN: " + r.messages + "\n");
print("old x[C.Blue](1) = " + String(val(x[C.Blue], 1, "ENO_res.mat")) + "\n");
setCommandLineOptions("--newBackend");
r := simulate(EN, stopTime=1, fileNamePrefix="ENN"); print("new EN: " + r.messages + "\n"); print(getErrorString());
r := simulate(EN2, stopTime=1, fileNamePrefix="EN2N"); print("new EN2: " + r.messages + "\n"); print(getErrorString());
