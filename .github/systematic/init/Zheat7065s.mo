model Zheat7065s
  Modelica.Thermal.HeatTransfer.Sources.PrescribedTemperature amb1;
  Modelica.Blocks.Sources.Sine src1(amplitude=21.7, f=0.0359, offset=295, phase=5.943);
  Modelica.Thermal.HeatTransfer.Components.HeatCapacitor C1(C=240.2, T(start=293.4), der_T(fixed=true));
  Modelica.Thermal.HeatTransfer.Components.HeatCapacitor C2(C=571, T(start=320.1), der_T(fixed=true));
  Modelica.Thermal.HeatTransfer.Components.HeatCapacitor C3(C=388.8, T(start=290.7), der_T(fixed=true));
  Modelica.Thermal.HeatTransfer.Components.HeatCapacitor C4(C=3060, T(start=338.8), der_T(fixed=true));
  Modelica.Thermal.HeatTransfer.Components.Convection conv1;
  Modelica.Blocks.Sources.ExpSine src2(amplitude=9.045, f=0.07996, damping=0.01381, offset=25.5);
  Modelica.Thermal.HeatTransfer.Components.ThermalResistor Rth1(R=0.05105);
  Modelica.Thermal.HeatTransfer.Components.BodyRadiation rad1(Gr=1.111);
  Modelica.Thermal.HeatTransfer.Components.ThermalResistor Rth2(R=0.02908);
  Modelica.Thermal.HeatTransfer.Components.ThermalConductor G1(G=0.1312);
  Modelica.Thermal.HeatTransfer.Components.Convection conv2;
  Modelica.Blocks.Sources.CombiTimeTable src3(table=[0, 27.33; 5.853, 25.53; 6.197, 49.28; 6.647, 40.74; 8.859, 38.76; 11.29, 25.45], smoothness=Modelica.Blocks.Types.Smoothness.MonotoneContinuousDerivative1, extrapolation=Modelica.Blocks.Types.Extrapolation.LastTwoPoints);
  Modelica.Thermal.HeatTransfer.Components.ThermalConductor G2(G=0.6145);
  Modelica.Thermal.HeatTransfer.Components.ThermalConductor G3(G=0.4042);
  Modelica.Thermal.HeatTransfer.Sources.FixedHeatFlow Q1(Q_flow=-1.654);
  Modelica.Thermal.HeatTransfer.Celsius.TemperatureSensor Tc1;
  Modelica.Thermal.HeatTransfer.Sensors.TemperatureSensor Ts1;
equation
  connect(src1.y, amb1.T);
  connect(src2.y, conv1.Gc);
  connect(src3.y[1], conv2.Gc);
  connect(amb1.port, conv1.fluid);
  connect(conv1.fluid, Rth1.port_b);
  connect(Rth1.port_b, Rth2.port_b);
  connect(Rth2.port_b, G2.port_a);
  connect(G2.port_a, G3.port_a);
  connect(C1.port, conv1.solid);
  connect(conv1.solid, rad1.port_b);
  connect(rad1.port_b, Tc1.port);
  connect(Rth1.port_a, Q1.port);
  connect(C2.port, rad1.port_a);
  connect(rad1.port_a, G1.port_b);
  connect(G1.port_b, conv2.fluid);
  connect(conv2.fluid, Ts1.port);
  connect(Rth2.port_a, G2.port_b);
  connect(C3.port, G1.port_a);
  connect(G1.port_a, G3.port_b);
  connect(C4.port, conv2.solid);
  annotation(experiment(StartTime=0, StopTime=14, Interval=0.07));
end Zheat7065s;
