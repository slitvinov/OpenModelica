model Zbheat7007s
  Modelica.Thermal.HeatTransfer.Sources.FixedTemperature amb1(T=298.9);
  Modelica.Thermal.HeatTransfer.Components.HeatCapacitor C1(C=6208, T(start=303.3), der_T(fixed=true));
  Modelica.Thermal.HeatTransfer.Components.HeatCapacitor C2(C=4949, T(start=325.8), der_T(fixed=true));
  Modelica.Thermal.HeatTransfer.Components.HeatCapacitor C3(C=72.23, T(start=347.8), der_T(fixed=true));
  Modelica.Thermal.HeatTransfer.Components.HeatCapacitor C4(C=9942, T(start=309), der_T(fixed=true));
  Modelica.Thermal.HeatTransfer.Components.HeatCapacitor C5(C=25.59, T(start=281.6), der_T(fixed=true));
  Modelica.Thermal.HeatTransfer.Components.ThermalConductor G1(G=2.408);
  Modelica.Thermal.HeatTransfer.Components.ThermalResistor Rth1(R=3.626);
  Modelica.Thermal.HeatTransfer.Components.BodyRadiation rad1(Gr=0.4562);
  Buildings.HeatTransfer.Convection.Interior bcon1(A=4.243, til=Buildings.Types.Tilt.Wall, conMod=Buildings.HeatTransfer.Types.InteriorConvection.Temperature);
  Modelica.Thermal.HeatTransfer.Components.ThermalConductor G2(G=13.16);
  Modelica.Thermal.HeatTransfer.Components.ThermalConductor G3(G=12.65);
  Modelica.Thermal.HeatTransfer.Components.ThermalResistor Rth2(R=6.903);
  Modelica.Thermal.HeatTransfer.Components.ThermalResistor Rth3(R=0.05302);
  Modelica.Thermal.HeatTransfer.Sensors.HeatFlowSensor hfs1;
  Modelica.Thermal.HeatTransfer.Components.ThermalConductor G4(G=49.26);
  Modelica.Thermal.HeatTransfer.Sources.PrescribedHeatFlow Q1(T_ref=282.4, alpha=-0.0006604);
  Modelica.Blocks.Sources.ExpSine src1(amplitude=135.8, f=7.133e-05, damping=3.97e-05, offset=50);
  Modelica.Thermal.HeatTransfer.Sources.PrescribedHeatFlow Q2(T_ref=311.3, alpha=0);
  Modelica.Blocks.Sources.CombiTimeTable src2(table=[0, 126.1; 4893, -94.67; 6866, 23.65; 8441, 65.04], smoothness=Modelica.Blocks.Types.Smoothness.ConstantSegments, extrapolation=Modelica.Blocks.Types.Extrapolation.Periodic);
  Modelica.Thermal.HeatTransfer.Celsius.TemperatureSensor Tc1;
  Modelica.Thermal.HeatTransfer.Celsius.TemperatureSensor Tc2;
  Modelica.Thermal.HeatTransfer.Celsius.TemperatureSensor Tc3;
equation
  connect(src1.y, Q1.Q_flow);
  connect(src2.y[1], Q2.Q_flow);
  connect(amb1.port, G1.port_b);
  connect(G1.port_b, Rth1.port_b);
  connect(C1.port, G1.port_a);
  connect(G1.port_a, rad1.port_b);
  connect(rad1.port_b, bcon1.fluid);
  connect(bcon1.fluid, G3.port_b);
  connect(G3.port_b, Rth3.port_b);
  connect(Rth3.port_b, hfs1.port_b);
  connect(C2.port, Rth1.port_a);
  connect(Rth1.port_a, Rth2.port_b);
  connect(Rth2.port_b, Q2.port);
  connect(Q2.port, Tc1.port);
  connect(rad1.port_a, G2.port_b);
  connect(G2.port_b, G4.port_a);
  connect(G4.port_a, Q1.port);
  connect(C3.port, bcon1.solid);
  connect(bcon1.solid, G4.port_b);
  connect(G4.port_b, Tc3.port);
  connect(C4.port, G2.port_a);
  connect(C5.port, G3.port_a);
  connect(Rth2.port_a, Rth3.port_a);
  connect(Rth3.port_a, hfs1.port_a);
  connect(hfs1.port_a, Tc2.port);
  annotation(experiment(StartTime=0, StopTime=1.09e+04, Interval=54.5));
end Zbheat7007s;
