model Zbheat7060s
  Modelica.Thermal.HeatTransfer.Sources.FixedTemperature amb1(T=291.2);
  Modelica.Thermal.HeatTransfer.Components.HeatCapacitor C1(C=2468, T(start=333.9), der_T(fixed=true));
  Modelica.Thermal.HeatTransfer.Components.HeatCapacitor C2(C=658.8, T(start=307.1), der_T(fixed=true));
  Modelica.Thermal.HeatTransfer.Components.HeatCapacitor C3(C=133.4, T(start=296.7), der_T(fixed=true));
  Modelica.Thermal.HeatTransfer.Components.ThermalConductor G1(G=0.1026);
  Modelica.Thermal.HeatTransfer.Components.BodyRadiation rad1(Gr=0.5755);
  Modelica.Thermal.HeatTransfer.Components.BodyRadiation rad2(Gr=0.03699);
  Modelica.Thermal.HeatTransfer.Components.BodyRadiation rad3(Gr=0.9503);
  Modelica.Thermal.HeatTransfer.Components.ThermalConductor G2(G=0.1595);
  Modelica.Thermal.HeatTransfer.Components.ThermalResistor Rth1(R=0.1581);
  Modelica.Thermal.HeatTransfer.Sources.PrescribedHeatFlow Q1(T_ref=299.8, alpha=-0.007342);
  Modelica.Blocks.Sources.Trapezoid src1(amplitude=91.06, rising=2304, width=3455, falling=2304, period=1.152e+04, offset=-100, startTime=2851);
  Modelica.Thermal.HeatTransfer.Sources.FixedHeatFlow Q2(Q_flow=-8.024);
  Modelica.Thermal.HeatTransfer.Sources.FixedHeatFlow Q3(Q_flow=67.82);
  Modelica.Thermal.HeatTransfer.Components.ThermalResistor Rth2(R=6.39);
  Modelica.Thermal.HeatTransfer.Sources.PrescribedHeatFlow Q4(T_ref=306.2, alpha=-0.009157);
  Modelica.Blocks.Sources.Trapezoid src2(amplitude=126.9, rising=1843, width=2765, falling=1843, period=9216, offset=-100, startTime=4609);
  Modelica.Thermal.HeatTransfer.Components.Convection conv1;
  Modelica.Blocks.Sources.TimeTable src3(table=[0, 24.27; 8662, 32.38; 2.49e+04, 11.33; 2.613e+04, 29.08; 2.713e+04, 33.49]);
  Modelica.Thermal.HeatTransfer.Sensors.TemperatureSensor Ts1;
equation
  connect(src1.y, Q1.Q_flow);
  connect(src2.y, Q4.Q_flow);
  connect(src3.y, conv1.Gc);
  connect(amb1.port, G1.port_b);
  connect(G1.port_b, rad3.port_b);
  connect(C1.port, G1.port_a);
  connect(G1.port_a, rad1.port_b);
  connect(rad1.port_b, G2.port_b);
  connect(C2.port, rad1.port_a);
  connect(rad1.port_a, rad2.port_b);
  connect(rad2.port_b, Q3.port);
  connect(Q3.port, Rth2.port_a);
  connect(rad2.port_a, Q1.port);
  connect(Q1.port, Q2.port);
  connect(Q2.port, conv1.fluid);
  connect(conv1.fluid, Ts1.port);
  connect(rad3.port_a, Rth1.port_b);
  connect(C3.port, G2.port_a);
  connect(G2.port_a, conv1.solid);
  connect(Rth1.port_a, Rth2.port_b);
  connect(Rth2.port_b, Q4.port);
  annotation(experiment(StartTime=0, StopTime=3.21e+04, Interval=160.5));
end Zbheat7060s;
