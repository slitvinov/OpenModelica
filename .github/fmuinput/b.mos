buildModelFMU(I.WithInput, version = "2.0", fmuType = "cs", fileNamePrefix = "WithInput"); getErrorString();
buildModelFMU(I.NoInput, version = "2.0", fmuType = "cs", fileNamePrefix = "NoInput"); getErrorString();
