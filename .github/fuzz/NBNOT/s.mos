echo(false);
loadFile("N.mo");
r := simulate(N, stopTime = 0.01, fileNamePrefix = "old"); print(r.messages);
setCommandLineOptions("--newBackend");
r := simulate(N, stopTime = 0.01, fileNamePrefix = "new"); print(r.messages + getErrorString());
for p in {"old", "new"} loop
  f := p + "_res.mat";
  print(p + ": b = {" + String(val(b[1], 0, f)) + ", " + String(val(b[2], 0, f)) + "}, nb = {" + String(val(nb[1], 0, f)) + ", " + String(val(nb[2], 0, f)) + "}, n1 = " + String(val(n1, 0, f)) + "\n");
end for;
