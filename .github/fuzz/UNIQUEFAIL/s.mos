echo(false);
loadFile("U.mo");
x1 := -0.6; x2 := -0.7; x3 := 0.0; x4 := 0.7; x5 := 0.0;
print("residuals at the exact solution: " + String(1.2*x1 - 0.5*x5 + 0.6*sinh(x1) - (1.2*(-0.6) + 0.6*sinh(-0.6))) + " "
  + String(0.7*x2 - 0.2*x3 + 0.3*sinh(x2) - (0.7*(-0.7) + 0.3*sinh(-0.7))) + " "
  + String(0.2*x2 + 1.5*x3 + 0.3*x3^5 + 0.4*x4 - (0.2*(-0.7) + 0.4*0.7)) + " "
  + String(-0.4*x3 + 1.7*x4 + x5 + 0.3*exp(x4) - (1.7*0.7 + 0.3*exp(0.7))) + " "
  + String(0.5*x1 - x4 + 1.2*x5 + 0.3*x5^5 - (0.5*(-0.6) - 0.7)) + "\n");
for o in {"", "-nls=hybrid", "-nls=newton", "-nls=kinsol", "--newBackend", "--tearingMethod=noTearing"} loop
  if o == "--newBackend" then setCommandLineOptions(o); end if;
  if o == "--tearingMethod=noTearing" then setCommandLineOptions("--newBackend=false " + o); end if;
  r := simulate(U, simflags = if o == "" or o == "--newBackend" or o == "--tearingMethod=noTearing" then "" else o);
  print("### " + (if o == "" then "old backend" else o) + "\n");
  l := strtok(r.messages, "\n"); n := 0;
  for i in 1:size(l, 1) loop
    if i > 1 and l[i] == l[i - 1] then n := n + 1; else
      if n > 0 then print("(the line above repeated " + String(n) + " more times)\n"); n := 0; end if;
      print(l[i] + "\n");
    end if;
  end for;
  if n > 0 then print("(the line above repeated " + String(n) + " more times)\n"); end if;
  if r.resultFile <> "" then
    print("x = " + String(val(x1, 0, r.resultFile)) + " " + String(val(x2, 0, r.resultFile)) + " " + String(val(x3, 0, r.resultFile)) + " " + String(val(x4, 0, r.resultFile)) + " " + String(val(x5, 0, r.resultFile)) + "\n");
  end if;
end for;
