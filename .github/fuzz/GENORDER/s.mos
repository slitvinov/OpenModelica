loadModel(Modelica, {"4.0.0"}); getErrorString();
loadFile("PowerSystems/package.mo"); getErrorString();
for tol in {1e-6, 1e-10} loop
  res := simulate(PowerSystems.Examples.AC3ph.Generation.GenOrder3and7, tolerance=tol, fileNamePrefix="g", simflags="-emit_protected");
  print(res.messages + getErrorString());
  print("tolerance " + String(tol) + "\n");
  for v in {"turboGen2.generator.powerAngle", "turboGen1.generator.powerAngle", "relayGrd.y[1]", "switchGrd2.switch_a.closed"} loop
    print("  " + v + " " + String(val(stringVariableName(v), 0.099), significantDigits=10)
      + " " + String(val(stringVariableName(v), 0.101), significantDigits=10)
      + " " + String(val(stringVariableName(v), 0.105), significantDigits=10) + "\n");
  end for;
end for;
