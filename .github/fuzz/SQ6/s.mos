loadFile("SQ6.mo"); getErrorString();
for m in {"SQ6", "SQ6smooth", "SQ6noEvent", "SQ6disc", "SQ6then"} loop
  print("=== " + m + "\n");
  r := simulate(stringTypeName("P." + m), stopTime = 1);
  print(r.messages + "\n" + getErrorString() + "\n");
  if regularFileExists("P." + m + "_res.mat") then
    print("x1(0) = " + String(val(x1, 0.0, "P." + m + "_res.mat")) + ", x1(1) = " + String(val(x1, 1.0, "P." + m + "_res.mat")) + "\n");
  end if;
end for;
setCommandLineOptions("--newBackend"); getErrorString();
for m in {"SQ6", "SQ6noEvent", "SQ6disc"} loop
  print("=== new backend " + m + "\n");
  r := simulate(stringTypeName("P." + m), stopTime = 1, fileNamePrefix = "NB_" + m);
  print(r.messages + "\n" + getErrorString() + "\n");
  if regularFileExists("NB_" + m + "_res.mat") then
    print("x1(0) = " + String(val(x1, 0.0, "NB_" + m + "_res.mat")) + ", x1(1) = " + String(val(x1, 1.0, "NB_" + m + "_res.mat")) + "\n");
  end if;
end for;
