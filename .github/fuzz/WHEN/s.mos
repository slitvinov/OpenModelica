echo(false);
loadFile("NI.mo"); loadFile("CH.mo"); loadFile("V.mo"); print(getErrorString());
ni := {"NI", "V.NI0", "V.NI1", "V.NI2", "V.NI3", "V.NI4", "V.NI5"};
ch := {"CH", "V.C1", "V.C2", "V.C3", "V.C4", "V.C5", "V.C6", "V.C7"};
for p in {"O", "N"} loop
  if p == "N" then setCommandLineOptions("--newBackend"); end if;
  for m in ni loop
    r := simulate(stringTypeName(m), stopTime = 1, fileNamePrefix = p + m); print(getErrorString());
    print(p + " " + m + ": n(0.5) = " + String(val(n, 0.5, p + m + "_res.mat")) + "\n");
  end for;
  for m in ch loop
    r := simulate(stringTypeName(m), stopTime = 2, fileNamePrefix = p + m); print(getErrorString());
    print(p + " " + m + ": n, e (1.5) = " + String(val(n, 1.5, p + m + "_res.mat")) + " " + String(val(e, 1.5, p + m + "_res.mat")) + "\n");
  end for;
end for;
