loadFile("R.mo"); getErrorString();
for s in {"1", "1e10", "1e12", "1e14"} loop
  res := simulate(R, simflags="-lssMinSize=1 -lssMaxDensity=1 -override=s=" + s);
  print("s = " + s + ": " + res.messages + "\n");
end for;
for s in {"1e10", "1e12", "1e14"} loop
  res := simulate(R, simflags="-lssMinSize=1 -lssMaxDensity=1 -noScaling -override=s=" + s);
  print("-noScaling s = " + s + ": " + res.messages + "\n");
end for;
