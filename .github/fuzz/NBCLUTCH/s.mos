echo(false);
installPackage(Modelica, "4.1.0+maint.om", exactMatch=true); loadModel(Modelica, {"4.1.0"}); getErrorString();
loadFile("B.mo"); loadFile("C.mo"); getErrorString();
r := simulate(B, stopTime = 1); print(getErrorString());
r := simulate(C, stopTime = 1); print(getErrorString());
r := simulate(Modelica.Mechanics.Rotational.Examples.CoupledClutches, fileNamePrefix = "CC");
setCommandLineOptions("--newBackend");
r := simulate(B, stopTime = 1, fileNamePrefix = "NB_B"); print(getErrorString());
r := simulate(C, stopTime = 1, fileNamePrefix = "NB_C"); print(getErrorString());
r := simulate(Modelica.Mechanics.Rotational.Examples.CoupledClutches, fileNamePrefix = "NB_CC");
for t in {0, 0.5, 0.9} loop
  print("B t=" + String(t) + ": b=" + String(val(b, t, "B_res.mat")) + " | newBackend b=" + String(val(b, t, "NB_B_res.mat")) + "\n");
end for;
for t in {0, 0.25, 0.5, 1} loop
  print("C t=" + String(t) + ": J1.w=" + String(val(J1.w, t, "C_res.mat")) + " clutch.tau=" + String(val(clutch.tau, t, "C_res.mat")) + " | newBackend J1.w=" + String(val(J1.w, t, "NB_C_res.mat")) + " clutch.tau=" + String(val(clutch.tau, t, "NB_C_res.mat")) + "\n");
end for;
for t in {0.5, 1, 1.5} loop
  print("CoupledClutches t=" + String(t) + ": J1.w=" + String(val(J1.w, t, "CC_res.mat")) + " | newBackend J1.w=" + String(val(J1.w, t, "NB_CC_res.mat")) + "\n");
end for;
