loadFile("S.mo"); getErrorString();
for m in {"M1", "M10000", "M50000"} loop
  buildModelFMU(stringTypeName("S." + m), version = "2.0", fmuType = "cs", fileNamePrefix = m);
  r := simulate(stringTypeName("S." + m), stopTime = 20, numberOfIntervals = 20000, method = "euler", variableFilter = "x");
  print(m + " simulate: " + String(1e6 * r.timeSimulation / 20000) + " us per step\n");
end for;
getErrorString();
