model U
  Real x1, x2, x3, x4, x5;
equation
  1.2*x1 - 0.5*x5 + 0.6*sinh(x1) = 1.2*(-0.6) + 0.6*sinh(-0.6);
  0.7*x2 - 0.2*x3 + 0.3*sinh(x2) = 0.7*(-0.7) + 0.3*sinh(-0.7);
  0.2*x2 + 1.5*x3 + 0.3*x3^5 + 0.4*x4 = 0.2*(-0.7) + 0.4*0.7;
  -0.4*x3 + 1.7*x4 + x5 + 0.3*exp(x4) = 1.7*0.7 + 0.3*exp(0.7);
  0.5*x1 - x4 + 1.2*x5 + 0.3*x5^5 = 0.5*(-0.6) - 0.7;
end U;
