model S "unknowns x = z/s; exact solution x = {-0.6, -0.7, 0.1, 0.7, 0.1}"
  parameter Real s = 1e-9;
  Real z1(start = 0.9*(-0.6)*s), z2(start = 0.9*(-0.7)*s), z3(start = 0.9*0.1*s), z4(start = 0.9*0.7*s), z5(start = 0.9*0.1*s);
equation
  1.2*z1/s - 0.5*z5/s + 0.6*sinh(z1/s) = 1.2*(-0.6) - 0.5*0.1 + 0.6*sinh(-0.6);
  0.7*z2/s - 0.2*z3/s + 0.3*sinh(z2/s) = 0.7*(-0.7) - 0.2*0.1 + 0.3*sinh(-0.7);
  0.2*z2/s + 1.5*z3/s + 0.3*(z3/s)^5 + 0.4*z4/s = 0.2*(-0.7) + 1.5*0.1 + 0.3*0.1^5 + 0.4*0.7;
  -0.4*z3/s + 1.7*z4/s + z5/s + 0.3*exp(z4/s) = -0.4*0.1 + 1.7*0.7 + 0.1 + 0.3*exp(0.7);
  0.5*z1/s - z4/s + 1.2*z5/s + 0.3*(z5/s)^5 = 0.5*(-0.6) - 0.7 + 1.2*0.1 + 0.3*0.1^5;
end S;
model S1 = S(s = 1);
